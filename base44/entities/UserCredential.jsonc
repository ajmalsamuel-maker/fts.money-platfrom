{
  "name": "UserCredential",
  "type": "object",
  "properties": {
    "credential_type": {
      "type": "string",
      "enum": [
        "lei",
        "vlei",
        "oor",
        "ecr"
      ],
      "description": "Type of credential (LEI, vLEI, Organizational Role, Engagement Context)"
    },
    "credential_name": {
      "type": "string",
      "description": "User-friendly name for the credential"
    },
    "lei_number": {
      "type": "string",
      "description": "20-character Legal Entity Identifier"
    },
    "vlei_credential": {
      "type": "string",
      "description": "W3C Verifiable Credential JSON"
    },
    "public_key": {
      "type": "string",
      "description": "Public key for cryptographic verification"
    },
    "issuer": {
      "type": "string",
      "description": "Qualified vLEI Issuer (QVI) identifier"
    },
    "issuer_name": {
      "type": "string",
      "description": "Human-readable issuer name"
    },
    "issued_date": {
      "type": "string",
      "format": "date-time",
      "description": "When credential was issued"
    },
    "expiry_date": {
      "type": "string",
      "format": "date-time",
      "description": "When credential expires"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked",
        "pending"
      ],
      "default": "active"
    },
    "credential_chain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Parent credential references for provenance"
    },
    "trust_score": {
      "type": "number",
      "default": 0,
      "description": "Trust score 0-100"
    },
    "used_for_services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of services using this credential"
    },
    "last_used": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "description": "Additional credential metadata"
    }
  },
  "required": [
    "credential_type",
    "credential_name"
  ]
}