{
  "name": "PSPConnectorAssignment",
  "type": "object",
  "properties": {
    "psp_code": {
      "type": "string",
      "description": "PSP tenant identifier"
    },
    "psp_name": {
      "type": "string"
    },
    "platform_connector_id": {
      "type": "string",
      "description": "Reference to PlatformConnector"
    },
    "connector_name": {
      "type": "string",
      "description": "Connector name for reference"
    },
    "assignment_status": {
      "type": "string",
      "enum": [
        "assigned",
        "active",
        "suspended",
        "revoked"
      ],
      "default": "assigned",
      "description": "Assignment lifecycle status"
    },
    "enabled_by_psp": {
      "type": "boolean",
      "default": false,
      "description": "Whether PSP admin has enabled this connector"
    },
    "psp_configuration": {
      "type": "object",
      "description": "PSP-specific settings (merchant mappings, routing rules)"
    },
    "usage_limits": {
      "type": "object",
      "properties": {
        "monthly_volume_limit": {
          "type": "number"
        },
        "monthly_transaction_limit": {
          "type": "number"
        },
        "daily_volume_limit": {
          "type": "number"
        }
      }
    },
    "pricing_model": {
      "type": "string",
      "enum": [
        "volume_based",
        "transaction_based",
        "flat_rate",
        "tiered"
      ],
      "default": "volume_based"
    },
    "psp_markup_percentage": {
      "type": "number",
      "description": "PSP's markup on top of platform fee",
      "default": 0
    },
    "psp_fixed_fee": {
      "type": "number",
      "default": 0
    },
    "billing_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether FTS bills PSP for this connector"
    },
    "assigned_date": {
      "type": "string",
      "format": "date-time"
    },
    "activated_date": {
      "type": "string",
      "format": "date-time",
      "description": "When PSP first enabled the connector"
    },
    "assigned_by": {
      "type": "string",
      "description": "FTS admin who assigned"
    },
    "priority": {
      "type": "number",
      "default": 100,
      "description": "Routing priority for this PSP"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "psp_code",
    "platform_connector_id",
    "connector_name"
  ]
}