{
  "name": "MerchantUser",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string"
    },
    "merchant_code": {
      "type": "string",
      "description": "Merchant code for login"
    },
    "merchant_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "operator",
        "viewer"
      ],
      "default": "viewer"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending"
      ],
      "default": "pending"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_terminals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phone": {
      "type": "string"
    },
    "last_login": {
      "type": "string",
      "format": "date-time"
    },
    "last_login_ip": {
      "type": "string",
      "description": "IP address of last login"
    },
    "password_hash": {
      "type": "string"
    },
    "temp_password": {
      "type": "string"
    },
    "must_change_password": {
      "type": "boolean",
      "default": true
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "merchant_id",
    "merchant_code",
    "email",
    "full_name"
  ]
}