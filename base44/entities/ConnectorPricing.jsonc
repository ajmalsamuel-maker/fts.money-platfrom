{
  "name": "ConnectorPricing",
  "type": "object",
  "properties": {
    "platform_connector_id": {
      "type": "string",
      "description": "Reference to PlatformConnector"
    },
    "connector_name": {
      "type": "string"
    },
    "psp_code": {
      "type": "string",
      "description": "Specific PSP or 'default' for all PSPs"
    },
    "pricing_tier": {
      "type": "string",
      "enum": [
        "startup",
        "growth",
        "enterprise",
        "custom"
      ],
      "default": "startup"
    },
    "pricing_model": {
      "type": "string",
      "enum": [
        "per_transaction",
        "volume_percentage",
        "flat_monthly",
        "tiered",
        "custom"
      ],
      "default": "per_transaction"
    },
    "per_transaction_fee": {
      "type": "number",
      "description": "Fixed fee per transaction (USD)"
    },
    "volume_percentage": {
      "type": "number",
      "description": "Percentage of transaction volume"
    },
    "flat_monthly_fee": {
      "type": "number",
      "description": "Monthly subscription fee for connector access"
    },
    "tiered_pricing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "min_volume": {
            "type": "number"
          },
          "max_volume": {
            "type": "number"
          },
          "fee_percentage": {
            "type": "number"
          },
          "per_transaction_fee": {
            "type": "number"
          }
        }
      },
      "description": "Volume-based tier pricing"
    },
    "included_monthly_volume": {
      "type": "number",
      "description": "Free monthly volume included"
    },
    "included_monthly_transactions": {
      "type": "number",
      "description": "Free monthly transactions included"
    },
    "overage_fee_per_transaction": {
      "type": "number"
    },
    "overage_fee_percentage": {
      "type": "number"
    },
    "minimum_monthly_fee": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "scheduled"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "platform_connector_id",
    "connector_name",
    "pricing_model"
  ]
}