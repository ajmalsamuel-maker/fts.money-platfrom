{
  "name": "ComplianceCertification",
  "type": "object",
  "properties": {
    "psp_id": {
      "type": "string",
      "description": "Reference to PSP or Tenant"
    },
    "psp_name": {
      "type": "string",
      "description": "PSP name for quick reference"
    },
    "certification_type": {
      "type": "string",
      "enum": [
        "PCI_DSS",
        "ISO27001",
        "SOC2_Type1",
        "SOC2_Type2",
        "GDPR",
        "ISO20022",
        "ISO8583",
        "FIPS140_2",
        "HIPAA",
        "FedRAMP"
      ],
      "description": "Type of certification"
    },
    "certification_level": {
      "type": "string",
      "description": "Level/tier of certification (e.g., PCI DSS Level 1)"
    },
    "certification_body": {
      "type": "string",
      "description": "Organization that issued certification"
    },
    "certificate_number": {
      "type": "string",
      "description": "Unique certificate identifier"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "When certificate was issued"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "When certificate expires"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "suspended",
        "in_renewal",
        "pending"
      ],
      "default": "active"
    },
    "renewal_due_date": {
      "type": "string",
      "format": "date",
      "description": "When renewal process should start"
    },
    "auditor_name": {
      "type": "string",
      "description": "Name of auditor/assessor"
    },
    "auditor_company": {
      "type": "string",
      "description": "Auditing company name"
    },
    "audit_date": {
      "type": "string",
      "format": "date",
      "description": "When last audit occurred"
    },
    "next_audit_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled next audit"
    },
    "certificate_url": {
      "type": "string",
      "description": "Link to certificate document"
    },
    "report_url": {
      "type": "string",
      "description": "Link to audit report"
    },
    "scope": {
      "type": "string",
      "description": "Scope of certification"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "remediated": {
            "type": "boolean"
          },
          "remediation_date": {
            "type": "string"
          }
        }
      },
      "description": "Audit findings and remediation"
    },
    "cost": {
      "type": "number",
      "description": "Cost of certification/audit"
    },
    "auto_renewal": {
      "type": "boolean",
      "default": false,
      "description": "Automatic renewal enabled"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether expiry notification sent"
    }
  },
  "required": [
    "psp_id",
    "certification_type",
    "issue_date",
    "expiry_date"
  ]
}