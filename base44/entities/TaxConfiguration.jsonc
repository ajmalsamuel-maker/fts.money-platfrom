{
  "name": "TaxConfiguration",
  "type": "object",
  "properties": {
    "psp_code": {
      "type": "string",
      "description": "PSP/Service identifier (for multi-tenancy)"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "psp",
        "iso_gateway",
        "orchestration",
        "crypto_gateway",
        "rwa_platform",
        "platform"
      ],
      "description": "Which service this config applies to"
    },
    "entity_id": {
      "type": "string",
      "description": "Specific entity ID (merchant_id, customer_id, etc.)"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "merchant",
        "customer",
        "service",
        "global"
      ],
      "default": "global"
    },
    "vat_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for VAT functionality"
    },
    "calculation_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "manual",
        "hybrid"
      ],
      "default": "automatic",
      "description": "How tax is calculated"
    },
    "tax_point": {
      "type": "string",
      "enum": [
        "invoice_date",
        "payment_date",
        "service_date"
      ],
      "default": "payment_date",
      "description": "When tax obligation arises"
    },
    "home_jurisdiction": {
      "type": "string",
      "description": "Primary tax jurisdiction code"
    },
    "tax_id_number": {
      "type": "string",
      "description": "VAT/Tax registration number"
    },
    "registered_jurisdictions": {
      "type": "array",
      "description": "Jurisdictions where registered",
      "items": {
        "type": "string"
      }
    },
    "default_category": {
      "type": "string",
      "default": "DIGITAL_SERVICES",
      "description": "Default tax category for transactions"
    },
    "apply_to_fees": {
      "type": "boolean",
      "default": true,
      "description": "Whether to apply VAT to processing fees"
    },
    "inclusive_pricing": {
      "type": "boolean",
      "default": false,
      "description": "Whether displayed prices include VAT"
    },
    "show_vat_on_invoice": {
      "type": "boolean",
      "default": true
    },
    "moss_oss_enabled": {
      "type": "boolean",
      "default": false,
      "description": "EU One-Stop-Shop for VAT"
    },
    "reverse_charge_enabled": {
      "type": "boolean",
      "default": false,
      "description": "B2B reverse charge mechanism"
    },
    "threshold_monitoring": {
      "type": "boolean",
      "default": true,
      "description": "Monitor registration thresholds"
    },
    "auto_invoice_generation": {
      "type": "boolean",
      "default": true
    },
    "invoice_prefix": {
      "type": "string",
      "description": "Invoice number prefix (e.g., INV-2026-)"
    },
    "invoice_sequence": {
      "type": "number",
      "default": 1,
      "description": "Current invoice sequence number"
    },
    "exemption_rules": {
      "type": "array",
      "description": "Custom exemption rules",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string"
          },
          "exempt_jurisdictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "service_type",
    "entity_type"
  ]
}