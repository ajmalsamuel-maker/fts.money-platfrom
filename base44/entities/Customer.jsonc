{
  "name": "Customer",
  "type": "object",
  "properties": {
    "merchant_id": {
      "type": "string",
      "description": "Reference to Merchant entity"
    },
    "merchant_name": {
      "type": "string",
      "description": "Merchant name for reference"
    },
    "customer_id": {
      "type": "string",
      "description": "Unique customer identifier"
    },
    "email": {
      "type": "string",
      "description": "Customer email address"
    },
    "full_name": {
      "type": "string",
      "description": "Customer full name"
    },
    "phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "company_name": {
      "type": "string",
      "description": "Company name for B2B customers"
    },
    "billing_address": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "shipping_address": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "total_transactions": {
      "type": "number",
      "default": 0,
      "description": "Total number of transactions"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "Lifetime value"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "risk_score": {
      "type": "number",
      "description": "Risk score (0-100)"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "blocked",
        "suspended"
      ],
      "default": "active"
    },
    "default_payment_method_id": {
      "type": "string",
      "description": "Reference to SavedCard entity"
    },
    "metadata": {
      "type": "object",
      "description": "Custom metadata"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Customer tags for segmentation"
    }
  },
  "required": [
    "merchant_id",
    "email"
  ]
}