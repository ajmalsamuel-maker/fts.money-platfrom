{
  "name": "PSPSettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "PSP company name"
    },
    "psp_code": {
      "type": "string",
      "description": "Unique PSP identifier code for login"
    },
    "legal_name": {
      "type": "string",
      "description": "Full legal entity name"
    },
    "registration_number": {
      "type": "string",
      "description": "Company registration number"
    },
    "vat_number": {
      "type": "string",
      "description": "VAT/Tax ID number"
    },
    "license_number": {
      "type": "string",
      "description": "Payment services license number"
    },
    "licensing_authority": {
      "type": "string",
      "description": "Regulatory authority (e.g., FCA, BaFin)"
    },
    "address_line1": {
      "type": "string"
    },
    "address_line2": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "support_email": {
      "type": "string"
    },
    "support_phone": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "UTC",
      "description": "IANA timezone identifier (e.g., America/New_York)"
    },
    "base_currency": {
      "type": "string",
      "default": "USD",
      "description": "Base currency for PSP operations (ISO 4217)"
    },
    "allow_psp_code_login": {
      "type": "boolean",
      "default": true,
      "description": "Allow users to login with PSP code instead of email"
    },
    "password_reset_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Allow password reset functionality"
    }
  },
  "required": [
    "company_name"
  ]
}