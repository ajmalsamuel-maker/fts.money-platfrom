{
  "name": "LEICredential",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "psp",
        "merchant",
        "platform",
        "iso_gateway",
        "orchestration",
        "crypto_banking",
        "rwa_provider",
        "asset_issuer"
      ],
      "description": "Type of entity that owns this credential"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the entity (PSP, Merchant, etc.)"
    },
    "entity_name": {
      "type": "string",
      "description": "Name of the entity"
    },
    "lei": {
      "type": "string",
      "description": "20-character Legal Entity Identifier"
    },
    "lei_status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "pending",
        "lapsed"
      ],
      "default": "pending",
      "description": "LEI registration status"
    },
    "vlei_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "active",
        "revoked"
      ],
      "default": "none",
      "description": "vLEI credential status"
    },
    "vlei_credential": {
      "type": "string",
      "description": "W3C Verifiable Credential JSON"
    },
    "issuer": {
      "type": "string",
      "description": "LEI issuing organization"
    },
    "issued_date": {
      "type": "string",
      "format": "date",
      "description": "When LEI was issued"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "When LEI expires"
    },
    "renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Next renewal date"
    },
    "grace_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "When grace period expires"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "pending",
        "failed"
      ],
      "default": "pending"
    },
    "gleif_data": {
      "type": "object",
      "description": "Raw data from GLEIF verification"
    },
    "last_verified_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "lei"
  ]
}