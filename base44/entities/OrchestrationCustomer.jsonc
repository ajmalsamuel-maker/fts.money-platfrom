{
  "name": "OrchestrationCustomer",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "customer_code": {
      "type": "string",
      "description": "Unique customer code for login"
    },
    "company_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending",
        "suspended"
      ],
      "default": "pending"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "starter",
        "professional",
        "enterprise"
      ],
      "default": "starter"
    },
    "monthly_transaction_limit": {
      "type": "number",
      "default": 10000
    },
    "current_month_transactions": {
      "type": "number",
      "default": 0
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    },
    "enabled_languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "en"
      ],
      "description": "Enabled languages for this customer portal"
    },
    "default_language": {
      "type": "string",
      "default": "en",
      "description": "Default language for this customer portal"
    },
    "lei": {
      "type": "string",
      "description": "Customer Legal Entity Identifier"
    },
    "vlei_credential": {
      "type": "string",
      "description": "Customer vLEI credential"
    },
    "parent_lei": {
      "type": "string",
      "description": "FTS.Money platform LEI"
    },
    "lei_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "grace_period",
        "expired",
        "required"
      ],
      "default": "pending"
    },
    "lei_verified_date": {
      "type": "string",
      "format": "date-time"
    },
    "vlei_issued_date": {
      "type": "string",
      "format": "date-time"
    },
    "grace_period_start": {
      "type": "string",
      "format": "date-time"
    },
    "grace_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "lei_application_id": {
      "type": "string"
    }
  },
  "required": [
    "customer_code",
    "company_name",
    "contact_email"
  ]
}