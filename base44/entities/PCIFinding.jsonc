{
  "name": "PCIFinding",
  "type": "object",
  "properties": {
    "requirement_number": {
      "type": "string",
      "description": "Related PCI requirement"
    },
    "finding_title": {
      "type": "string",
      "description": "Title of the finding"
    },
    "finding_description": {
      "type": "string",
      "description": "Detailed description"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "default": "medium"
    },
    "finding_type": {
      "type": "string",
      "enum": [
        "gap",
        "vulnerability",
        "non_compliance",
        "observation",
        "best_practice"
      ],
      "description": "Type of finding"
    },
    "identified_by": {
      "type": "string",
      "description": "Who identified this finding"
    },
    "identified_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "accepted_risk",
        "false_positive"
      ],
      "default": "open"
    },
    "assigned_to": {
      "type": "string",
      "description": "Person responsible for remediation"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "resolution_date": {
      "type": "string",
      "format": "date"
    },
    "remediation_plan": {
      "type": "string",
      "description": "Plan to address the finding"
    },
    "remediation_notes": {
      "type": "string"
    },
    "evidence_url": {
      "type": "string",
      "description": "Evidence of finding/resolution"
    },
    "business_impact": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "description": "Impact on business operations"
    },
    "cvss_score": {
      "type": "number",
      "description": "CVSS score if applicable"
    }
  },
  "required": [
    "requirement_number",
    "finding_title",
    "severity"
  ]
}