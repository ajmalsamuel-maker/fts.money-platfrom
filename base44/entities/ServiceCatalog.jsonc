{
  "name": "ServiceCatalog",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string",
      "description": "Unique service identifier"
    },
    "service_name": {
      "type": "string",
      "description": "Display name of the service"
    },
    "service_category": {
      "type": "string",
      "enum": [
        "payment_rail",
        "compliance",
        "fraud_detection",
        "analytics",
        "crypto",
        "developer_tools",
        "orchestration",
        "payout"
      ],
      "description": "Service category"
    },
    "version": {
      "type": "string",
      "description": "Semantic version (e.g., 1.0.0, 2.1.3)",
      "default": "1.0.0"
    },
    "is_latest_version": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the latest version"
    },
    "version_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "release_date": {
            "type": "string"
          },
          "changelog": {
            "type": "string"
          },
          "breaking_changes": {
            "type": "boolean"
          }
        }
      },
      "description": "Version change history"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "development",
        "beta",
        "GA",
        "mature",
        "deprecated",
        "sunset"
      ],
      "default": "development",
      "description": "Service lifecycle stage"
    },
    "deprecation_date": {
      "type": "string",
      "format": "date",
      "description": "When service will be deprecated"
    },
    "sunset_date": {
      "type": "string",
      "format": "date",
      "description": "When service will be completely removed"
    },
    "migration_guide_url": {
      "type": "string",
      "description": "URL to migration guide for deprecated services"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string"
          },
          "service_name": {
            "type": "string"
          },
          "version_requirement": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      },
      "description": "Services this service depends on"
    },
    "dependents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service IDs that depend on this service"
    },
    "bundled_in": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Bundle IDs that include this service"
    },
    "is_bundle": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a bundle of other services"
    },
    "bundle_components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string"
          },
          "service_name": {
            "type": "string"
          },
          "is_optional": {
            "type": "boolean"
          }
        }
      },
      "description": "Services included in this bundle"
    },
    "bundle_discount_percentage": {
      "type": "number",
      "description": "Discount when purchasing as bundle vs individual"
    },
    "health_check_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether automated health checks are enabled"
    },
    "health_check_url": {
      "type": "string",
      "description": "Endpoint for health check"
    },
    "health_check_interval": {
      "type": "number",
      "default": 300,
      "description": "Health check interval in seconds"
    },
    "last_health_check": {
      "type": "string",
      "format": "date-time",
      "description": "Last health check timestamp"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "down",
        "unknown"
      ],
      "default": "unknown"
    },
    "uptime_percentage": {
      "type": "number",
      "description": "30-day uptime percentage"
    },
    "health_incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "description": "Recent health incidents"
    },
    "auto_generated_docs": {
      "type": "string",
      "description": "Auto-generated documentation (markdown)"
    },
    "docs_last_generated": {
      "type": "string",
      "format": "date-time"
    },
    "api_endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "API endpoints exposed by this service"
    },
    "provider_id": {
      "type": "string",
      "description": "Reference to ServiceProvider entity"
    },
    "provider_name": {
      "type": "string",
      "description": "Provider name for quick reference"
    },
    "is_fts_owned": {
      "type": "boolean",
      "default": false,
      "description": "True if service is developed by FTS"
    },
    "description": {
      "type": "string",
      "description": "Short description (1-2 sentences)"
    },
    "long_description": {
      "type": "string",
      "description": "Detailed markdown description"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of key features"
    },
    "pricing_model": {
      "type": "string",
      "enum": [
        "fixed",
        "per_transaction",
        "tiered",
        "custom"
      ],
      "description": "Pricing structure"
    },
    "base_price": {
      "type": "number",
      "description": "Monthly base price (if applicable)"
    },
    "variable_price": {
      "type": "number",
      "description": "Per-transaction or per-call price"
    },
    "pricing_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "volume_min": {
            "type": "number"
          },
          "volume_max": {
            "type": "number"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "description": "Volume-based pricing tiers"
    },
    "trial_available": {
      "type": "boolean",
      "default": false
    },
    "trial_duration_days": {
      "type": "number",
      "description": "Free trial period in days"
    },
    "integration_complexity": {
      "type": "string",
      "enum": [
        "simple",
        "moderate",
        "complex"
      ],
      "default": "moderate"
    },
    "estimated_setup_time": {
      "type": "string",
      "description": "e.g., '30 minutes', '2 hours', '1 day'"
    },
    "documentation_url": {
      "type": "string",
      "description": "Link to documentation"
    },
    "api_spec_url": {
      "type": "string",
      "description": "OpenAPI spec URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "under_review",
        "certified",
        "active",
        "deprecated"
      ],
      "default": "draft"
    },
    "certification_date": {
      "type": "string",
      "format": "date"
    },
    "uptime_sla": {
      "type": "number",
      "description": "SLA percentage (e.g., 99.9)"
    },
    "avg_latency_ms": {
      "type": "number",
      "description": "Average response time in milliseconds"
    },
    "rating": {
      "type": "number",
      "description": "Average rating (0-5)"
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "total_subscribers": {
      "type": "number",
      "default": 0,
      "description": "Number of PSPs subscribed"
    },
    "banner_image_url": {
      "type": "string"
    },
    "icon_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags"
    }
  },
  "required": [
    "service_name",
    "service_category",
    "provider_id",
    "pricing_model"
  ]
}