{
  "name": "AppUser",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "finance",
        "operations",
        "compliance",
        "technical",
        "editor",
        "viewer",
        "merchant"
      ],
      "default": "viewer"
    },
    "department": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending"
      ],
      "default": "active"
    },
    "password_hash": {
      "type": "string"
    },
    "must_change_password": {
      "type": "boolean",
      "default": false
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether 2FA is enabled for this user"
    },
    "two_factor_method": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "authenticator"
      ],
      "default": "email",
      "description": "2FA delivery method for this user"
    },
    "last_login": {
      "type": "string",
      "format": "date-time"
    },
    "last_login_ip": {
      "type": "string",
      "description": "IP address of last login"
    },
    "lei": {
      "type": "string",
      "description": "Legal Entity Identifier (20 characters)"
    },
    "vlei_credential": {
      "type": "string",
      "description": "W3C Verifiable Credential JSON"
    },
    "credential_chain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Parent LEI references"
    },
    "oor_role": {
      "type": "string",
      "description": "Organizational Role credential"
    },
    "ecr_context": {
      "type": "object",
      "description": "Engagement Context Record"
    },
    "lei_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "verified",
        "grace_period",
        "expired"
      ],
      "default": "not_required"
    },
    "lei_verified_date": {
      "type": "string",
      "format": "date-time"
    },
    "vlei_issued_date": {
      "type": "string",
      "format": "date-time"
    },
    "credential_expiry": {
      "type": "string",
      "format": "date-time"
    },
    "grace_period_start": {
      "type": "string",
      "format": "date-time"
    },
    "grace_period_end": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email",
    "full_name"
  ]
}