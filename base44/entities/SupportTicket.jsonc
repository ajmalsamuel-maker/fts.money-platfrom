{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "Unique ticket identifier"
    },
    "subject": {
      "type": "string",
      "description": "Ticket subject"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the issue"
    },
    "category": {
      "type": "string",
      "enum": [
        "technical",
        "billing",
        "onboarding",
        "compliance",
        "general"
      ],
      "default": "general"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "waiting_for_customer",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "requester_name": {
      "type": "string"
    },
    "requester_email": {
      "type": "string"
    },
    "requester_phone": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string",
      "description": "Associated merchant ID if applicable"
    },
    "assigned_to": {
      "type": "string",
      "description": "Staff member assigned to ticket"
    },
    "resolution_notes": {
      "type": "string"
    },
    "resolved_date": {
      "type": "string",
      "format": "date-time"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "subject",
    "description",
    "requester_email"
  ]
}