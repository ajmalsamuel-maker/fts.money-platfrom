{
  "name": "MerchantBalance",
  "type": "object",
  "properties": {
    "merchant_id": {
      "type": "string"
    },
    "merchant_name": {
      "type": "string"
    },
    "psp_id": {
      "type": "string"
    },
    "psp_name": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "gross_volume": {
      "type": "number",
      "default": 0
    },
    "net_volume": {
      "type": "number",
      "default": 0
    },
    "available_balance": {
      "type": "number",
      "default": 0
    },
    "pending_balance": {
      "type": "number",
      "default": 0
    },
    "reserved_balance": {
      "type": "number",
      "default": 0
    },
    "fees_collected": {
      "type": "number",
      "default": 0
    },
    "chargebacks_amount": {
      "type": "number",
      "default": 0
    },
    "refunds_amount": {
      "type": "number",
      "default": 0
    },
    "transaction_count": {
      "type": "number",
      "default": 0
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "settlement_due_date": {
      "type": "string",
      "format": "date"
    },
    "contract_terms": {
      "type": "object"
    }
  },
  "required": [
    "merchant_id",
    "psp_id"
  ]
}