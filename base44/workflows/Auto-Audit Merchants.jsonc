{
  "name": "Auto-Audit: Merchants",
  "description": "Automatically log all merchant entity changes to audit log",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update",
        "delete"
      ],
      "entity_name": "Merchant"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_audit_merchants",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoAuditLogger",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoAuditLogger"
  }
}